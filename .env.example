# ─── Site ────────────────────────────────────────────────────────────────
# Production URL, no trailing slash. Used for canonical URLs, sitemap, Open Graph and JSON-LD.
# While unset (or localhost), every page is noindex and robots.txt blocks crawling.
NEXT_PUBLIC_SITE_URL=

# Set to "false" on staging/preview deployments to keep them out of search results.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Preview unconfirmed services and doctor profiles (labelled "Draft", noindex, not in sitemap).
# NEVER enable on the live site.
SHOW_DRAFT_CONTENT=false

# ─── Appointment requests (email via Resend) ─────────────────────────────
# When both RESEND_API_KEY and APPOINTMENT_EMAIL_TO are set, the booking form emails requests
# to the clinic. Without them, the form validates and hands the request off to WhatsApp.
RESEND_API_KEY=
# Comma-separated list of clinic inboxes that receive requests.
APPOINTMENT_EMAIL_TO=
# Must be on a domain verified in Resend, e.g. "Maple Medical Center <appointments@yourdomain.ae>".
APPOINTMENT_EMAIL_FROM=

# ─── Analytics (optional — nothing loads when both are empty) ────────────
# Prefer GTM if you manage tags there; otherwise GA4 directly. Set only one.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
